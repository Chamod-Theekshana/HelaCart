<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability (FCM via APNs). Xcode/App Store export
	     switches this to "production" from the distribution profile. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links for shared product/shop URLs. Must match APP_LINK_HOST;
	     https://helacart.lk/.well-known/apple-app-site-association must list
	     <TEAM_ID>.com.helacart.buyer. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:helacart.lk</string>
	</array>
</dict>
</plist>
