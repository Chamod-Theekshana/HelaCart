generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerMemberRole {
  OWNER
  MANAGER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  firebaseUid   String         @unique
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  memberships   SellerMember[]
  sellerReviews SellerReview[]
  productReviews ProductReview[]
  inventoryMovements InventoryMovement[]
  addresses      BuyerAddress[]
  cartItems      CartItem[]
  orders         Order[]
  orderEvents    SellerOrderEvent[]
  notifications  Notification[]
  returnRequests ReturnRequest[] @relation("BuyerReturns")
  returnReviews  ReturnRequest[] @relation("AdminReturns")
  returnResolutions ReturnRequest[] @relation("AdminReturnResolutions")
  codReviews     CodReconciliation[]
}

model Seller {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  description   String?
  contactPhone  String?
  pickupAddress String?
  status        SellerStatus   @default(PENDING)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  members       SellerMember[]
  reviews       SellerReview[]
  products      Product[]
  variants      ProductVariant[]
  sellerOrders  SellerOrder[]
  shippingFeeLkrMinor Int?

  @@index([status])
}

enum SellerReviewDecision {
  APPROVED
  REJECTED
}

model SellerReview {
  id             String               @id @default(uuid()) @db.Uuid
  sellerId       String               @db.Uuid
  reviewerUserId String               @db.Uuid
  decision       SellerReviewDecision
  reason         String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  seller         Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  reviewer       User                 @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([reviewerUserId])
}

model SellerMember {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  sellerId  String           @db.Uuid
  role      SellerMemberRole @default(MANAGER)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller    Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([sellerId, userId])
  @@index([userId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  products  Product[]
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  sellerId      String        @db.Uuid
  categoryId    String        @db.Uuid
  title         String
  slug          String
  description   String
  sku           String
  priceLkrMinor Int
  imageUrls     String[]      @default([])
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews       ProductReview[]
  variants      ProductVariant[]

  @@unique([sellerId, slug])
  @@unique([sellerId, sku])
  @@index([status, createdAt])
  @@index([categoryId, status])
}

model ProductVariant {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @db.Uuid
  sellerId      String   @db.Uuid
  position      Int
  sku           String
  optionValues  Json     @default("{}")
  priceLkrMinor Int
  onHand        Int      @default(0)
  reserved      Int      @default(0)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  movements     InventoryMovement[]
  reservations  InventoryReservation[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@unique([sellerId, sku])
  @@unique([productId, position])
  @@index([sellerId, productId])
}

model InventoryMovement {
  id          String   @id @default(uuid()) @db.Uuid
  variantId   String   @db.Uuid
  actorUserId String?  @db.Uuid
  delta       Int
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([variantId, createdAt])
}

enum InventoryReservationStatus {
  ACTIVE
  RELEASED
  COMMITTED
  EXPIRED
}

model InventoryReservation {
  id        String   @id @default(uuid()) @db.Uuid
  requestKey String  @unique
  variantId String   @db.Uuid
  quantity  Int
  status    InventoryReservationStatus @default(ACTIVE)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([status, expiresAt])
  @@index([variantId, status])
}

enum ProductReviewDecision {
  APPROVED
  REJECTED
}

model ProductReview {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @db.Uuid
  reviewerUserId String                @db.Uuid
  decision       ProductReviewDecision
  reason         String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviewer       User                  @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([reviewerUserId])
}

model BuyerAddress {
  id          String @id @default(uuid()) @db.Uuid
  userId      String @db.Uuid
  recipient   String
  phone       String
  line1       String
  line2       String?
  city        String
  district    String
  postalCode  String
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  orders      Order[]

  @@index([userId, createdAt])
}

model CartItem {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  variantId String @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@unique([userId, variantId])
  @@index([variantId])
}

enum SellerOrderStatus {
  PLACED
  ACCEPTED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id                  String @id @default(uuid()) @db.Uuid
  buyerId             String @db.Uuid
  addressId           String @db.Uuid
  checkoutKey         String
  snapshotHash        String
  recipient           String
  phone               String
  line1               String
  line2               String?
  city                String
  district            String
  postalCode          String
  subtotalLkrMinor    Int
  shippingLkrMinor    Int
  totalLkrMinor       Int
  paymentMethod       String @default("COD")
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  buyer               User @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  address             BuyerAddress @relation(fields: [addressId], references: [id], onDelete: Restrict)
  sellerOrders        SellerOrder[]

  @@unique([buyerId, checkoutKey])
  @@index([buyerId, createdAt])
}

model SellerOrder {
  id                 String @id @default(uuid()) @db.Uuid
  orderId            String @db.Uuid
  sellerId           String @db.Uuid
  status             SellerOrderStatus @default(PLACED)
  subtotalLkrMinor   Int
  shippingLkrMinor   Int
  totalLkrMinor      Int
  paymentCollectedAt DateTime? @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  order              Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  seller             Seller @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  events             SellerOrderEvent[]
  returnRequest      ReturnRequest?
  codReconciliations CodReconciliation[]

  @@unique([orderId, sellerId])
  @@index([sellerId, createdAt])
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  sellerOrderId  String @db.Uuid
  variantId      String @db.Uuid
  productTitle   String
  sku            String
  optionValues   Json
  unitLkrMinor   Int
  quantity       Int
  lineLkrMinor   Int
  sellerOrder    SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId])
}

model SellerOrderEvent {
  id            String @id @default(uuid()) @db.Uuid
  sellerOrderId String @db.Uuid
  actorUserId   String @db.Uuid
  fromStatus    SellerOrderStatus
  toStatus      SellerOrderStatus
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  actor         User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([sellerOrderId, createdAt])
}

enum NotificationType {
  ORDER_PLACED
  ORDER_UPDATED
  RETURN_REQUESTED
  RETURN_REVIEWED
  COD_RECONCILED
}

model Notification {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  type      NotificationType
  subjectId String @db.Uuid
  message   String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  readAt    DateTime? @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RESOLVED
}

model ReturnRequest {
  id             String @id @default(uuid()) @db.Uuid
  sellerOrderId  String @unique @db.Uuid
  buyerId        String @db.Uuid
  status         ReturnStatus @default(PENDING)
  reason         String
  reviewReason   String?
  resolutionNote String?
  reviewerUserId String? @db.Uuid
  resolverUserId String? @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  reviewedAt     DateTime? @db.Timestamptz(3)
  resolvedAt     DateTime? @db.Timestamptz(3)
  sellerOrder    SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  buyer          User @relation("BuyerReturns", fields: [buyerId], references: [id], onDelete: Restrict)
  reviewer       User? @relation("AdminReturns", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  resolver       User? @relation("AdminReturnResolutions", fields: [resolverUserId], references: [id], onDelete: Restrict)

  @@index([buyerId, createdAt])
  @@index([status, createdAt])
}

enum CodReconciliationDecision {
  RECONCILED
  DISPUTED
}

model CodReconciliation {
  id                 String @id @default(uuid()) @db.Uuid
  sellerOrderId      String @db.Uuid
  reviewerUserId     String @db.Uuid
  decision           CodReconciliationDecision
  amountReceivedMinor Int
  reference          String
  note               String?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  sellerOrder        SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  reviewer           User @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@unique([sellerOrderId, reference])
  @@index([sellerOrderId, createdAt])
  @@index([decision, createdAt])
}
