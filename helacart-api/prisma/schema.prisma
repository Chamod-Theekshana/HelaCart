generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum SellerMemberRole {
  OWNER
  MANAGER
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  firebaseUid   String         @unique
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  memberships   SellerMember[]
  sellerReviews SellerReview[]
  productReviews ProductReview[]
}

model Seller {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  slug          String         @unique
  description   String?
  contactPhone  String?
  pickupAddress String?
  status        SellerStatus   @default(PENDING)
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(3)
  members       SellerMember[]
  reviews       SellerReview[]
  products      Product[]

  @@index([status])
}

enum SellerReviewDecision {
  APPROVED
  REJECTED
}

model SellerReview {
  id             String               @id @default(uuid()) @db.Uuid
  sellerId       String               @db.Uuid
  reviewerUserId String               @db.Uuid
  decision       SellerReviewDecision
  reason         String?
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  seller         Seller               @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  reviewer       User                 @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([sellerId, createdAt])
  @@index([reviewerUserId])
}

model SellerMember {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  sellerId  String           @db.Uuid
  role      SellerMemberRole @default(MANAGER)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  seller    Seller           @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([sellerId, userId])
  @@index([userId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  products  Product[]
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

model Product {
  id            String        @id @default(uuid()) @db.Uuid
  sellerId      String        @db.Uuid
  categoryId    String        @db.Uuid
  title         String
  slug          String
  description   String
  sku           String
  priceLkrMinor Int
  imageUrls     String[]      @default([])
  status        ProductStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  seller        Seller        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  category      Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  reviews       ProductReview[]

  @@unique([sellerId, slug])
  @@unique([sellerId, sku])
  @@index([status, createdAt])
  @@index([categoryId, status])
}

enum ProductReviewDecision {
  APPROVED
  REJECTED
}

model ProductReview {
  id             String                @id @default(uuid()) @db.Uuid
  productId      String                @db.Uuid
  reviewerUserId String                @db.Uuid
  decision       ProductReviewDecision
  reason         String?
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  product        Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviewer       User                  @relation(fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([productId, createdAt])
  @@index([reviewerUserId])
}
