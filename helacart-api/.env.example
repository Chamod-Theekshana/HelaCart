NODE_ENV=development
PORT=4000
# Local-only by default. Use 0.0.0.0 on a container host or for device testing.
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
# Number of trusted reverse proxies in front of the API. Keep 0 for local development.
TRUST_PROXY_HOPS=0
# Return request deadline after seller order delivery.
RETURN_WINDOW_DAYS=14

# Copy BOTH complete URLs from the SAME Neon development branch/database/role.
# Runtime: Connection pooling ON. Preserve the TLS parameters from Neon.
DATABASE_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT-pooler.YOUR_REGION.aws.neon.tech/neondb?sslmode=require"
# Prisma CLI: Connection pooling OFF. Never run migrate dev against production.
DIRECT_URL="postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_ENDPOINT.YOUR_REGION.aws.neon.tech/neondb?sslmode=require"

# Firebase Admin SDK. Download the service-account JSON from Firebase Console,
# store it outside this project, and set its absolute path below.
FIREBASE_PROJECT_ID=helacart-949a0
GOOGLE_APPLICATION_CREDENTIALS="C:/Users/YOUR_WINDOWS_USER/firebase/helacart-admin.json"

# Comma-separated verified Firebase UIDs permitted to review seller applications.
# Leave empty during setup; admin routes then respond with 403.
ADMIN_FIREBASE_UIDS=

# Optional for local setup; set all five values to enable authenticated product
# image uploads. R2_PUBLIC_BASE_URL is a PUBLIC custom domain on this bucket.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Required for seller verification photos. Use a SEPARATE private bucket with
# public access/custom domains disabled. Never reuse R2_BUCKET for identity photos.
# Uses R2_ACCOUNT_ID, R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY above.
R2_PRIVATE_BUCKET=

# Refer to OPERATIONS-RUNBOOK.md before using production settings.

# --- November 2026 hardening release ------------------------------------------
# Prisma pool connections per API process (pg). Size so that
# replicas x DATABASE_POOL_SIZE stays below the Neon pooler limit.
DATABASE_POOL_SIZE=10
# Seconds a verified Firebase ID token is cached in memory (0-60, 0 disables).
# Suspension/deletion is still checked on every request.
AUTH_TOKEN_CACHE_SECONDS=60
# Production JSON logs include debug/verbose lines when set to "debug".
LOG_LEVEL=info

# Shared secret the Next.js storefront sends as x-helacart-internal for
# server-to-server calls (skips the per-IP general rate bucket). Use 32+ random
# characters in production, e.g. `openssl rand -hex 32`. Leave empty to disable.
INTERNAL_API_TOKEN=

# Rate limits (requests per minute per bucket). Authenticated callers are
# bucketed by IP + token subject and get MULTIPLIER x the limit per IP.
RATE_LIMIT_GENERAL_PER_MINUTE=180
RATE_LIMIT_WRITE_PER_MINUTE=20
RATE_LIMIT_CONTENT_PER_MINUTE=30
RATE_LIMIT_AUTHENTICATED_IP_MULTIPLIER=5

# COD order lifecycle and fraud controls.
# PLACED seller orders not accepted within this many hours are auto-cancelled.
SELLER_ACCEPT_HOURS=48
# Open (PLACED..SHIPPED, DELIVERY_FAILED) seller orders a buyer may have.
MAX_OPEN_COD_ORDERS=5
# Largest COD order total in LKR minor units (50000000 = LKR 500,000).
MAX_COD_ORDER_LKR_MINOR=50000000
# true: checkout requires an OTP-verified delivery phone (needs Notify.lk in production).
REQUIRE_PHONE_VERIFICATION=false

# SMS via Notify.lk (OTP codes and order SMS). Set all three or none. Without
# SMS outside production, OTP codes are written to the API log (dev only).
NOTIFY_LK_USER_ID=
NOTIFY_LK_API_KEY=
NOTIFY_LK_SENDER_ID=
# HMAC key for OTP codes (32+ characters). Required when Notify.lk is set.
OTP_SECRET=

# Email via Resend. Set both or none. RESEND_FROM must be a verified sender,
# e.g. "HelaCart <orders@helacart.lk>".
RESEND_API_KEY=
RESEND_FROM=
# Push via Firebase Cloud Messaging (uses the Firebase Admin credentials above).
PUSH_NOTIFICATIONS_ENABLED=true

# Keep false: the in-process reservation expiry loop is only needed if the
# (currently unused) inventory reservation primitive is enabled.
RESERVATIONS_ENABLED=false

# GET /api/v1/app-config (mobile force update, legal links, support contact).
APP_ANDROID_MIN_VERSION=1.0.0
APP_ANDROID_LATEST_VERSION=1.0.0
APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.helacart.buyer
APP_IOS_MIN_VERSION=1.0.0
APP_IOS_LATEST_VERSION=1.0.0
APP_IOS_STORE_URL=https://apps.apple.com/app/id0000000000
# Public web origin used for links in notification emails.
APP_WEB_BASE_URL=https://helacart.lk
LEGAL_PRIVACY_URL=https://helacart.lk/legal/privacy
LEGAL_TERMS_URL=https://helacart.lk/legal/terms
LEGAL_RETURNS_URL=https://helacart.lk/legal/returns
SUPPORT_EMAIL=support@helacart.lk
# E.164, e.g. +94112345678 (optional).
SUPPORT_PHONE=
