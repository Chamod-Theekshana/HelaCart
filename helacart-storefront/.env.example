# Leave blank to show an explicitly labelled Stitch design preview.
# Local API: http://localhost:4000/api/v1
# A production `next build` fails when this (or the Firebase settings below) is
# missing, unless NEXT_PUBLIC_ALLOW_PREVIEW_BUILD=1.
NEXT_PUBLIC_API_URL=

# Firebase Console → Project settings → Your apps → Web app.
# Public browser settings only. Never add a Firebase Admin service account here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public origin of this storefront, e.g. https://helacart.lk. Used for canonical
# URLs, OpenGraph, sitemap.xml and robots.txt. Enables HSTS when it is https.
NEXT_PUBLIC_SITE_URL=

# Set to 1 only for an intentional design-preview / CI build without the API or
# Firebase. Production builds should leave this empty.
NEXT_PUBLIC_ALLOW_PREVIEW_BUILD=

# Server-only (never NEXT_PUBLIC). Sent as `x-helacart-internal` on server-side
# API calls so the API's per-IP rate limit is skipped for the storefront server.
# Must match the API's INTERNAL_API_TOKEN. Use a long random value.
HELACART_INTERNAL_API_TOKEN=

# Comma-separated image origins allowed by the Content-Security-Policy and
# next/image, e.g. the API's R2_PUBLIC_BASE_URL: https://images.helacart.lk
# (the API origin is always allowed). Read at build time.
HELACART_IMAGE_ORIGINS=
